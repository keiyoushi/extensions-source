{
  "extends": [
    "config:recommended"
  ],
  "schedule": ["on sunday"],
  "includePaths": [
    "buildSrc/gradle/**",
    "buildSrc/*.gradle.kts",
    "gradle/**",
    "*.gradle.kts",
    ".github/**"
  ],
  "ignoreDeps": ["keiyoushi/issue-moderator-action"],
  "customManagers": [
    {
      "customType": "regex",
      "description": "The Keiyoushi Runtime artifacts, pinned to a keiyoushi/runtime release tag on JitPack",
      "managerFilePatterns": ["/^gradle/libs\\.versions\\.toml$/"],
      "matchStrings": ["keiyoushi-runtime = \"(?<currentValue>v\\d+)\""],
      "depNameTemplate": "keiyoushi/runtime",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "regex:^v(?<major>\\d+)$"
    }
  ],
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "{{manager}} dependencies"
    },
    {
      "matchManagers": ["gradle"],
      "enabled": false
    },
    {
      "matchPackageNames": [
        "androidx.webkit:webkit",
        "com.android.tools.build:gradle",
        "gradle"
      ],
      "draftPR": true,
      "enabled": true
    },
    {
      "matchPackageNames": [
        "com.android.tools.build:gradle",
        "com.android.tools.lint:lint-api",
        "com.android.tools.lint:lint-checks",
        "com.android.tools.lint:lint-tests"
      ],
      "groupName": "Android Gradle Plugin and Lint",
      "draftPR": true,
      "enabled": true
    },
    {
      "matchDepNames": ["keiyoushi/runtime"],
      "schedule": ["at any time"],
      "enabled": true
    }
  ]
}
